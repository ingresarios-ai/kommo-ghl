# ========================================================
# CONFIGURACIÓN KOMMO CRM & GOHIGHLEVEL (GHL)
# ========================================================

# Puerto del servidor
PORT=3000

# --------------------------------------------------------
# 1. CREDENCIALES DE KOMMO CRM
# --------------------------------------------------------
# Tu subdominio de Kommo (ejemplo: si tu url es https://tuempresa.kommo.com, coloca: tuempresa)
KOMMO_SUBDOMAIN=tuempresa

# Token de Larga Duración de Kommo:
# Obtenlo en Kommo -> Ajustes -> Integraciones -> Crear integración privada
# -> Generar token de acceso de larga duración.
KOMMO_ACCESS_TOKEN=tu_token_de_acceso_de_kommo_aqui

# --------------------------------------------------------
# 2. CREDENCIALES DE GOHIGHLEVEL (GHL API v2)
# --------------------------------------------------------
# Location ID (Subcuenta en GHL donde están los contactos)
# Obtenlo en GHL -> Settings -> Business Info -> Location ID
GHL_LOCATION_ID=tu_location_id_aqui

# Token de Acceso de GHL (API v2 - Private Integration Token)
# Obtenlo en GHL -> Settings -> Developers -> Private Integrations (o API Keys)
# Asegúrate de darle permisos a "contacts.readonly" o "contacts.write"
GHL_ACCESS_TOKEN=tu_token_de_ghl_aqui

# --------------------------------------------------------
# 3. SEGURIDAD (Opcional)
# --------------------------------------------------------
# Si deseas proteger tu endpoint con una clave en la query (ej: /webhook/kommo-lead?secret=mi_clave)
WEBHOOK_SECRET=
